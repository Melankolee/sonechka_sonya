# Блок travel-приложения для /etc/caddy/Caddyfile на 185.103.101.75.
# Вставляет и обновляет его travel/deploy/caddy-travel.sh — руками в Caddyfile
# не править, скрипт заменит всё между своими маркерами. Блок
# birthday.sonechka-sonya.ru (deploy/caddy-site.sh) живёт отдельно и не
# затрагивается.
#
# Сертификат выпускает и продлевает сам Caddy.
travel.sonechka-sonya.ru {
	encode zstd gzip

	# Вход. Матчер @locked (запросы к /api/* и /trips/* без верной cookie
	# travel_session, кроме /api/login) лежит только на сервере в
	# /etc/caddy/travel-auth.caddy — его вместе с хешем пароля пишет
	# travel/deploy/travel-auth.sh, в git токена нет. Basic auth не годится:
	# приложение с экрана «Домой» iOS не запоминает его и спрашивает пароль при
	# каждом запуске, а cookie живёт 400 дней. Оболочка приложения (HTML, JS)
	# открыта: в ней нет данных, а её код и так в публичном репозитории.
	import /etc/caddy/travel-auth.caddy

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Совпадает с CSP в vite.config.ts (preview). wasm-unsafe-eval — для
		# wasm-декодеров pdf.js, blob: в worker-src — для его воркера.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}

	root * /var/www/travel.sonechka-sonya.ru

	# API (travel/server/travel-api.py): создание и правка поездок, загрузка
	# документов. Лимит — с запасом над 50 МБ, которые пропускает сам сервис.
	handle /api/* {
		respond @locked `{"error":"Нужно войти"}` 401
		request_body {
			max_size 60MB
		}
		reverse_proxy 127.0.0.1:8788
	}

	# Данные поездок пишет API в /var/lib/travel/trips, а отдаёт Caddy напрямую.
	# Всегда перепроверяются: версию поездки приложение сравнивает по свежему
	# trip.json.
	handle /trips/* {
		respond @locked `{"error":"Нужно войти"}` 401
		root * /var/lib/travel
		header Cache-Control "no-cache"
		file_server
	}

	# Сборка приложения (заливает .github/workflows/deploy-travel.yml).
	# SPA-фолбэка нет: маршруты на хэше, а отсутствующий файл должен быть 404,
	# а не index.html с кодом 200 — иначе Service Worker закешировал бы HTML
	# вместо скрипта.
	handle {
		# Имена в /assets/ содержат хеш содержимого.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Точки входа обновления — всегда с сервера.
		@revalidate path / /index.html /sw.js /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"

		@manifest path *.webmanifest
		header @manifest Content-Type "application/manifest+json"

		file_server
	}
}
